rules_version = '2';

//
// Shadow Nexus Wave — Firebase Storage Security Rules
//
// Bucket: shadow-nexus-wave.firebasestorage.app
//
// Paths:
//   videos/{uid}/{videoId}/video.{ext}   — uploaded video files
//   thumbnails/{uid}/{fileName}           — video thumbnail images
//   profile-images/{uid}/{fileName}       — user profile images
//   covers/{uid}/{fileName}               — user cover images
//   stories/{uid}/{fileName}              — story media
//   posts/{uid}/{fileName}                — feed post media
//   music/{uid}/{fileName}                — profile music files
//

service firebase.storage {
  match /b/{bucket}/o {

    // ── Shared helpers ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isNonAnonymous() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isValidVideoType() {
      return request.resource.contentType.matches('video/.*');
    }

    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidAudioType() {
      return request.resource.contentType.matches('audio/.*');
    }

    // Max video size: 2 GB
    function isWithinVideoSizeLimit() {
      return request.resource.size <= 2 * 1024 * 1024 * 1024;
    }

    // Max image size: 10 MB
    function isWithinImageSizeLimit() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    // Max audio size: 100 MB
    function isWithinAudioSizeLimit() {
      return request.resource.size <= 100 * 1024 * 1024;
    }

    // ── Videos ──────────────────────────────────────────────────────────────
    //
    //   videos/{uid}/{videoId}/video.{ext}
    //   videos/{uid}/{filename}
    //
    // Only the authenticated owner (uid must match auth.uid) may upload.
    // Anyone may read (download URLs are used in the feed).

    match /videos/{uid}/{allPaths=**} {
      allow read: if true;
      allow create: if isOwner(uid)
        && isNonAnonymous()
        && isValidVideoType()
        && isWithinVideoSizeLimit();
      allow update: if isOwner(uid)
        && isNonAnonymous()
        && isValidVideoType()
        && isWithinVideoSizeLimit();
      allow delete: if isOwner(uid) && isNonAnonymous();
    }

    // ── Thumbnails ──────────────────────────────────────────────────────────
    //
    //   thumbnails/{uid}/{filename}

    match /thumbnails/{uid}/{allPaths=**} {
      allow read: if true;
      allow create: if isOwner(uid)
        && isNonAnonymous()
        && isValidImageType()
        && isWithinImageSizeLimit();
      allow update: if isOwner(uid)
        && isNonAnonymous()
        && isValidImageType()
        && isWithinImageSizeLimit();
      allow delete: if isOwner(uid) && isNonAnonymous();
    }

    // ── Avatars (legacy path used by early sfl-login registration) ────────────
    //   avatars/{uid}/{filename}
    //   Read-only now — new uploads go through Cloudflare R2.

    match /avatars/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && isNonAnonymous()
        && isValidImageType()
        && isWithinImageSizeLimit();
      allow delete: if isOwner(uid) && isNonAnonymous();
    }

    // ── Profile images ───────────────────────────────────────────────────────

    match /profile-images/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && isNonAnonymous()
        && isValidImageType()
        && isWithinImageSizeLimit();
      allow delete: if isOwner(uid) && isNonAnonymous();
    }

    // ── Cover images ─────────────────────────────────────────────────────────

    match /covers/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && isNonAnonymous()
        && isValidImageType()
        && isWithinImageSizeLimit();
      allow delete: if isOwner(uid) && isNonAnonymous();
    }

    // ── Stories ───────────────────────────────────────────────────────────────

    match /stories/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid)
        && isNonAnonymous()
        && (isValidImageType() || isValidVideoType())
        && isWithinVideoSizeLimit();
      allow delete: if isOwner(uid) && isNonAnonymous();
    }

    // ── Posts (feed post media) ────────────────────────────────────────────────

    match /posts/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && isNonAnonymous()
        && (isValidImageType() || isValidVideoType())
        && isWithinVideoSizeLimit();
      allow delete: if isOwner(uid) && isNonAnonymous();
    }

    // ── Profile music ──────────────────────────────────────────────────────────

    match /music/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid)
        && isNonAnonymous()
        && isValidAudioType()
        && isWithinAudioSizeLimit();
      allow delete: if isOwner(uid) && isNonAnonymous();
    }
  }
}
